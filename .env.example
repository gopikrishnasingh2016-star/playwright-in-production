# Copy to .env and fill in. .env is gitignored — never commit a real token.

# Optional. Without it, api.github.com allows 60 requests/hour.
# With a read-only fine-grained PAT (no scopes needed for public data): 5,000/hour.
# Create at: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=

# Override the User-Agent this suite identifies itself with.
# Several public APIs (Wikimedia especially) ask automated clients to send
# a descriptive one that a maintainer could use to contact you.
PW_USER_AGENT=
